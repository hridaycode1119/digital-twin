# ==========================================
# Application & Security Configuration
# ==========================================
APP_ENV=development
APP_NAME="TwinHealth API"
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# MongoDB Database Configuration
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/twinhealth
MONGODB_DB=twinhealth

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=twinhealth_user
POSTGRES_PASSWORD=twinhealth_secure_pass
POSTGRES_DB=twinhealth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://twinhealth_user:twinhealth_secure_pass@localhost:5432/twinhealth_db

# ==========================================
# Redis Cache & Broker Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Object Storage (MinIO / AWS S3)
# ==========================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=medical-records
STORAGE_USE_SSL=false

# ==========================================
# AI / ML / LLM APIs & Vector Database
# ==========================================
OPENAI_API_KEY=sk-placeholder
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=patient_health_records

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="TwinHealth"
